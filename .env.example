# Copiar a .env y llenar. El archivo .env NUNCA se sube al repositorio.
# Aquí van solo los NOMBRES de las variables y ningún valor real.

# Base de datos. SQLite para arrancar; PostgreSQL con TimescaleDB cuando haya volumen.
GLUCY_DATABASE_URL=

# Autenticación: token JWT de corta vigencia con rotación.
GLUCY_JWT_SECRET=
GLUCY_JWT_MINUTOS_VIGENCIA=15

# Modelo de lenguaje: Ollama corriendo en la red local del proyecto.
GLUCY_OLLAMA_URL=
GLUCY_OLLAMA_MODELO=qwen3:8b
GLUCY_EXPLICACION_TIMEOUT_S=10

# Artefacto del modelo predictivo que se carga en memoria al arrancar.
GLUCY_RUTA_ARTEFACTO_MODELO=

# Learning Record Store (Learning Locker, xAPI 1.0.3).
GLUCY_LRS_URL=
GLUCY_LRS_USUARIO=
GLUCY_LRS_SECRETO=
