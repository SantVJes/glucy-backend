# Copiar a .env y llenar. El archivo .env NUNCA se sube al repositorio.
# Aquí van solo los NOMBRES de las variables y ningún valor real.

# Base de datos (D-4). El motor lo decide esta URL y nada más:
#   SQLite, para desarrollo:        sqlite:///./glucy.db
#   PostgreSQL de docker-compose:   postgresql+psycopg://<usuario>:<contraseña>@base:5432/glucy
#                                   con el mismo usuario y contraseña de abajo.
GLUCY_DATABASE_URL=

# PostgreSQL con TimescaleDB de docker-compose.yml (paso 4). Los lee el servicio `base`.
POSTGRES_USER=
POSTGRES_PASSWORD=

# Solo para las pruebas marcadas `postgres` (pytest -m postgres). Sin ella, se saltan.
# Ojo: esas pruebas BORRAN el esquema public de esa base antes de cada una.
GLUCY_DATABASE_URL_POSTGRES=

# Autenticación: token JWT de corta vigencia con rotación.
GLUCY_JWT_SECRET=
GLUCY_JWT_MINUTOS_VIGENCIA=15

# Modelo de lenguaje: Ollama corriendo en la red local del proyecto.
GLUCY_OLLAMA_URL=
GLUCY_OLLAMA_MODELO=qwen3:8b
GLUCY_EXPLICACION_TIMEOUT_S=10

# Artefacto del modelo predictivo que se carga en memoria al arrancar.
GLUCY_RUTA_ARTEFACTO_MODELO=

# Learning Record Store (Learning Locker, xAPI 1.0.3), fase 6.
# Vacío = no se manda nada y las sentencias esperan en la cola. Ninguna función depende de él.
GLUCY_LRS_URL=
GLUCY_LRS_USUARIO=
GLUCY_LRS_SECRETO=
GLUCY_LRS_TIMEOUT_S=10
